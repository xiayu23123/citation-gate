     "id": "test-073",
     "category": "noise",
     "status": "not_found",
     "quote": "少腹里急，腹，手掌烦热"
    },
    {
     "id": "test-074",
     "category": "noise",
     "status": "not_found",
     "quote": "此为热在里，身必发黄"
    },
    {
     "id": "test-075",
     "category": "noise",
     "status": "not_found",
     "quote": "在音为，在声为歌"
    },
    {
     "id": "test-076",
     "category": "noise",
     "status": "not_found",
     "quote": "治伤寒今愈不复，紫石寒食散方"
    },
    {
     "id": "test-077",
     "category": "noise",
     "status": "not_found",
     "quote": "栝蒌薤薤白白酒汤主之。"
    },
    {
     "id": "test-078",
     "category": "noise",
     "status": "not_found",
     "quote": "此为为藏寒。蛔上入其膈故烦"
    },
    {
     "id": "test-079",
     "category": "noise",
     "status": "not_found",
     "quote": "少阴病，吐利，手足冷"
    },
    {
     "id": "test-080",
     "category": "noise",
     "status": "not_found",
     "quote": "心下满而烦，不能食者"
    },
    {
     "id": "test-081",
     "category": "noise",
     "status": "not_found",
     "quote": "告穷归夭，束手受败。"
    },
    {
     "id": "test-082",
     "category": "noise",
     "status": "not_found",
     "quote": "伤寒解后后，虚羸少气"
    },
    {
     "id": "test-083",
     "category": "noise",
     "status": "not_found",
     "quote": "外舍分分肉之间，令人消铄脱肉。"
    },
    {
     "id": "test-084",
     "category": "noise",
     "status": "not_found",
     "quote": "则血虚。血虚则筋也。"
    },
    {
     "id": "test-085",
     "category": "noise",
     "status": "not_found",
     "quote": "但心下者，此以医下之也。"
    },
    {
     "id": "test-086",
     "category": "noise",
     "status": "not_found",
     "quote": "气利，诃黎散主之。"
    },
    {
     "id": "test-087",
     "category": "noise",
     "status": "not_found",
     "quote": "尺寸参差，或或长。"
    },
    {
     "id": "test-088",
     "category": "noise",
     "status": "not_found",
     "quote": "胸中寒实，而不止者"
    },
    {
     "id": "test-089",
     "category": "noise",
     "status": "not_found",
     "quote": "二十日愈。其其证或未病而预见"
    },
    {
     "id": "test-090",
     "category": "noise",
     "status": "not_found",
     "quote": "脉而洪，身汗如油"
    },
    {
     "id": "test-091",
     "category": "noise",
     "status": "not_found",
     "quote": "中古之时，有至至人者"
    },
    {
     "id": "test-092",
     "category": "noise",
     "status": "not_found",
     "quote": "柔则养筋。开不得"
    },
    {
     "id": "test-093",
     "category": "noise",
     "status": "not_found",
     "quote": "其人叉手白冒心，心下悸"
    },
    {
     "id": "test-094",
     "category": "noise",
     "status": "not_found",
     "quote": "寸缓、关浮浮、尺弱，其人发热汗出"
    },
    {
     "id": "test-095",
     "category": "noise",
     "status": "not_found",
     "quote": "则腹满满、身热、不欲食"
    },
    {
     "id": "test-096",
     "category": "noise",
     "status": "not_found",
     "quote": "诸紧为寒。乘寒者"
    },
    {
     "id": "test-097",
     "category": "noise",
     "status": "not_found",
     "quote": "清邪中上，名曰洁洁也"
    },
    {
     "id": "test-098",
     "category": "noise",
     "status": "not_found",
     "quote": "手足温者者生。逆冷，脉沉细者"
    },
    {
     "id": "test-099",
     "category": "noise",
     "status": "not_found",
     "quote": "雷鸣切痛，胸胁满"
    },
    {
     "id": "test-100",
     "category": "noise",
     "status": "not_found",
     "quote": "喜怒不节，寒过度"
    },
    {
     "id": "test-101",
     "category": "noise",
     "status": "not_found",
     "quote": "有微热汗出、今白愈"
    },
    {
     "id": "test-102",
     "category": "noise",
     "status": "not_found",
     "quote": "阳气怫郁在表，解之"
    },
    {
     "id": "test-103",
     "category": "noise",
     "status": "not_found",
     "quote": "心者，火也，名少阴。脉洪大而长"
    },
    {
     "id": "test-104",
     "category": "noise",
     "status": "not_found",
     "quote": "下之而。若欲下之"
    },
    {
     "id": "test-105",
     "category": "noise",
     "status": "not_found",
     "quote": "烦热不卧，而反倚息者"
    },
    {
     "id": "test-106",
     "category": "noise",
     "status": "not_found",
     "quote": "至六曰，与承气汤一升。"
    },
    {
     "id": "test-107",
     "category": "noise",
     "status": "not_found",
     "quote": "少阴中风，脉阳阴浮者"
    },
    {
     "id": "test-108",
     "category": "noise",
     "status": "not_found",
     "quote": "胃中干，烦不得眠"
    },
    {
     "id": "test-109",
     "category": "noise",
     "status": "not_found",
     "quote": "屎定硬，乃攻之，宜大承气汤。"
    },
    {
     "id": "test-110",
     "category": "noise",
     "status": "not_found",
     "quote": "唇痿舌青，燥，但欲漱水不欲咽"
    }
   ]
  },
