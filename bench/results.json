     "id": "test-111",
     "category": "altered",
     "status": "fuzzy",
     "quote": "鲙食之，在心胸间化"
    },
    {
     "id": "test-112",
     "category": "altered",
     "status": "fuzzy",
     "quote": "一逆二从，阴阳表里"
    },
    {
     "id": "test-113",
     "category": "altered",
     "status": "fuzzy",
     "quote": "其脉实者必苦冒。其人本有支饮在胸中故也。"
    },
    {
     "id": "test-114",
     "category": "altered",
     "status": "fuzzy",
     "quote": "肝中懊𢙐者，身必发黄。"
    },
    {
     "id": "test-115",
     "category": "altered",
     "status": "fuzzy",
     "quote": "上利脉数，有微热汗出"
    },
    {
     "id": "test-116",
     "category": "altered",
     "status": "fuzzy",
     "quote": "炮；死狼牙一两，炙香"
    },
    {
     "id": "test-117",
     "category": "altered",
     "status": "fuzzy",
     "quote": "猪苓汤复利其大便故也。"
    },
    {
     "id": "test-118",
     "category": "altered",
     "status": "fuzzy",
     "quote": "腹满，手掌烦寒，唇口干燥"
    },
    {
     "id": "test-119",
     "category": "altered",
     "status": "fuzzy",
     "quote": "胆胃大肠小肠膀胱三焦六府皆为阴。"
    },
    {
     "id": "test-120",
     "category": "altered",
     "status": "fuzzy",
     "quote": "其冲在下，名曰太阳"
    },
    {
     "id": "test-121",
     "category": "altered",
     "status": "fuzzy",
     "quote": "但头汗出，往来热热"
    },
    {
     "id": "test-122",
     "category": "altered",
     "status": "fuzzy",
     "quote": "支饮不得息，葶苈大枣补肺汤主之。"
    },
    {
     "id": "test-123",
     "category": "altered",
     "status": "fuzzy",
     "quote": "心下痞，按之濡，其脉关下浮者"
    },
    {
     "id": "test-124",
     "category": "altered",
     "status": "fuzzy",
     "quote": "桂枝附子汤主之。若其人小便硬"
    },
    {
     "id": "test-125",
     "category": "altered",
     "status": "fuzzy",
     "quote": "滑则为气，虚气相搏"
    },
    {
     "id": "test-126",
     "category": "altered",
     "status": "fuzzy",
     "quote": "平旦人气生，日中而阴气隆"
    },
    {
     "id": "test-127",
     "category": "altered",
     "status": "fuzzy",
     "quote": "房室勿令竭乏，服食节其冷寒苦酸辛甘"
    },
    {
     "id": "test-128",
     "category": "altered",
     "status": "fuzzy",
     "quote": "热除者，必便脓血。"
    },
    {
     "id": "test-129",
     "category": "altered",
     "status": "fuzzy",
     "quote": "温表宜四逆汤，攻表宜桂枝汤。"
    },
    {
     "id": "test-130",
     "category": "altered",
     "status": "fuzzy",
     "quote": "其不两感于热，更不传经"
    },
    {
     "id": "test-131",
     "category": "altered",
     "status": "fuzzy",
     "quote": "胸上有寒，渴欲得饮而能"
    },
    {
     "id": "test-132",
     "category": "altered",
     "status": "fuzzy",
     "quote": "和煮取六升，去滓，温分五服。"
    },
    {
     "id": "test-133",
     "category": "altered",
     "status": "fuzzy",
     "quote": "重寒则寒。寒伤形，热伤气。"
    },
    {
     "id": "test-134",
     "category": "altered",
     "status": "fuzzy",
     "quote": "中病即止，必尽剂也。"
    },
    {
     "id": "test-135",
     "category": "altered",
     "status": "fuzzy",
     "quote": "地道通，故形坏而无子也。"
    },
    {
     "id": "test-136",
     "category": "altered",
     "status": "fuzzy",
     "quote": "无汗，心上满微痛，小便不利者"
    },
    {
     "id": "test-137",
     "category": "altered",
     "status": "fuzzy",
     "quote": "诸四逆厥者，不可上之"
    },
    {
     "id": "test-138",
     "category": "altered",
     "status": "fuzzy",
     "quote": "紧为热，沉紧相搏，结在关元"
    },
    {
     "id": "test-139",
     "category": "altered",
     "status": "fuzzy",
     "quote": "脉浮而迟，表热里热"
    },
    {
     "id": "test-140",
     "category": "altered",
     "status": "fuzzy",
     "quote": "少腹拘急，大便不利者"
    },
    {
     "id": "test-141",
     "category": "altered",
     "status": "fuzzy",
     "quote": "若小便色白者，少阳病形悉具。"
    },
    {
     "id": "test-142",
     "category": "altered",
     "status": "fuzzy",
     "quote": "问曰：热在上焦者，因咳为肾痿。"
    },
    {
     "id": "test-143",
     "category": "altered",
     "status": "fuzzy",
     "quote": "阴狐疝气者，偏有小小"
    },
    {
     "id": "test-144",
     "category": "altered",
     "status": "fuzzy",
     "quote": "法当上利。何以知之？"
    },
    {
     "id": "test-145",
     "category": "altered",
     "status": "fuzzy",
     "quote": "赤石脂二两，一法二分。"
    },
    {
     "id": "test-146",
     "category": "altered",
     "status": "fuzzy",
     "quote": "其应五时，上为太白星"
    },
    {
     "id": "test-147",
     "category": "altered",
     "status": "fuzzy",
     "quote": "若太阴病证不罢者"
    },
    {
     "id": "test-148",
     "category": "altered",
     "status": "fuzzy",
     "quote": "夫肝之病，泻用酸，助用焦苦"
    },
    {
     "id": "test-149",
     "category": "altered",
     "status": "fuzzy",
     "quote": "阳脉濡弱者，更遇于风"
    },
    {
     "id": "test-150",
     "category": "altered",
     "status": "fuzzy",
     "quote": "藏精于脾，其病发惊骇"
    },
    {
     "id": "test-151",
     "category": "altered",
     "status": "fuzzy",
     "quote": "吐之则生，其脉何类？"
    },
    {
     "id": "test-152",
     "category": "altered",
     "status": "fuzzy",
     "quote": "又治连年积冷，流注肝胸痛"
    },
    {
     "id": "test-153",
     "category": "altered",
     "status": "fuzzy",
     "quote": "阴气者，若天与日，失其所则折寿而不彰"
    },
    {
     "id": "test-154",
     "category": "altered",
     "status": "fuzzy",
     "quote": "诸浮数脉，应当发寒"
    },
    {
     "id": "test-155",
     "category": "altered",
     "status": "fuzzy",
     "quote": "师曰：六脏病各有所得者愈"
    },
    {
     "id": "test-156",
     "category": "altered",
     "status": "fuzzy",
     "quote": "手足热，骨节痛，脉沉者"
    },
    {
     "id": "test-157",
     "category": "altered",
     "status": "fuzzy",
     "quote": "形体不敝，精神散"
    },
    {
     "id": "test-158",
     "category": "altered",
     "status": "fuzzy",
     "quote": "为实烦也，栀子豉汤主之。"
    },
    {
     "id": "test-159",
     "category": "altered",
     "status": "fuzzy",
     "quote": "九日死；肺至悬绝，十二日生"
    },
    {
     "id": "test-160",
     "category": "altered",
     "status": "fuzzy",
     "quote": "脉数者，可下，下之则必烦"
    },
    {
     "id": "test-167",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "身为振振摇者，细辛桂枝白术甘草汤主之。"
    },
    {
     "id": "test-169",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "脉浮者，心下有水，小青龙加大黄汤主之。"
    },
    {
     "id": "test-171",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "大病差后，劳复者，桂枝栀子豉汤主之。"
    },
    {
     "id": "test-173",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "桂枝去栀子加蜀漆牡蛎龙骨救逆汤主之。"
    },
    {
     "id": "test-193",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "身疼痛，脉沉迟者，桂枝加防己生姜各一两人参三两新加汤主之。"
    }
   ]
