    {
     "id": "dev-166",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "岂容易哉！况黄柏下咽"
    },
    {
     "id": "dev-167",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "不必悉具。凡防己汤病证而下之"
    },
    {
     "id": "dev-168",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "火邪者，桂枝去栀子加蜀漆牡蛎龙骨救逆汤主之。"
    },
    {
     "id": "dev-169",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "桃仁去桂加茯苓白术汤方"
    },
    {
     "id": "dev-170",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "本云：加干姜。半夏泻心汤"
    },
    {
     "id": "dev-171",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "舌上白胎者，可与小茯苓汤。"
    },
    {
     "id": "dev-172",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "先煮人参一二沸，去上沫"
    },
    {
     "id": "dev-173",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "汗出必解，宜桃仁二麻黄一汤。"
    },
    {
     "id": "dev-174",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "薏苡防己败酱散方"
    },
    {
     "id": "dev-176",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "小青龙加黄连汤方"
    },
    {
     "id": "dev-177",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "因致衄者，茯苓汤主之。"
    },
    {
     "id": "dev-179",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "更饮石膏干姜汤。夜半阳气还"
    },
    {
     "id": "dev-180",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "湿家身烦疼，可与石膏加术汤发其汗为宜"
    },
    {
     "id": "dev-181",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "上七味，以水五升，先煮阿胶一二沸"
    },
    {
     "id": "dev-182",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "身必黄，麻石膏轺赤小豆汤主之。"
    },
    {
     "id": "dev-183",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "脉迟为寒，今与细辛汤复除其热"
    },
    {
     "id": "dev-184",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "黄柏，减二升，去上沫"
    },
    {
     "id": "dev-185",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "人参不中与也，食谷者哕。"
    },
    {
     "id": "dev-186",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "利止，亡血也，四逆加黄芩汤主之。"
    },
    {
     "id": "dev-187",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "若桂枝证不罢者，复与柴胡汤"
    },
    {
     "id": "dev-189",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "恶风，无汗而喘者，栀子汤主之。"
    },
    {
     "id": "dev-190",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "于杏仁汤方内，加入半夏半升"
    },
    {
     "id": "dev-191",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "于附子汤方内，加厚朴二两"
    },
    {
     "id": "dev-193",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "设胸满胁痛者，与小杏仁汤。"
    },
    {
     "id": "dev-195",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "病仍不解，烦躁者，葛根四逆汤主之。"
    },
    {
     "id": "dev-196",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "加厚朴二两，干姜五十个"
    },
    {
     "id": "dev-197",
     "category": "herb_swap",
     "status": "fuzzy",
     "quote": "杏仁本为解肌，若其人脉浮紧"
    }
   ]
